---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.slug}`}
>
  <article class="section" style="padding-top: 2.5rem;">
    <div class="container">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.25rem; font-size: 0.9rem;">
        <a href="/">Home</a>
        <span aria-hidden="true"> / </span>
        <a href="/blog">Blog</a>
        <span aria-hidden="true"> / </span>
        <span>{post.data.title}</span>
      </nav>
      
      <header style="max-width: 42rem; margin-bottom: 2rem;">
        <time datetime={post.data.pubDate.toISOString()} class="text-muted" style="font-size: 0.95rem;">
          {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <h1 style="margin-top: 0.5rem;">{post.data.title}</h1>
        <p class="text-muted">By {post.data.author}</p>
      </header>
      
      <div class="prose">
        <Content />
      </div>
      
      <div style="max-width: 42rem; margin: 3rem auto 0; padding-top: 2rem; border-top: 1px solid var(--color-border);">
        <p class="font-semibold">Need help with a plumbing issue in Lakewood?</p>
        <p class="text-muted">Call <a href={siteConfig.phoneHref}>{siteConfig.phone}</a> or <a href="/contact">send us a message</a>.</p>
      </div>
    </div>
  </article>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Plumbing Tips & Advice | Blog"
  description="Practical plumbing advice for Lakewood, Ohio homeowners—early warning signs, winter preparation, and maintenance tips from a local team."
  canonicalPath="/blog"
>
  <section class="section" style="padding-top: 2.5rem;">
    <div class="container">
      <div class="section-header" style="text-align: left; max-width: none;">
        <h1>Plumbing Blog</h1>
        <p class="text-muted" style="font-size: 1.1rem; max-width: 36rem;">
          Straightforward articles to help Lakewood homeowners understand common plumbing issues and simple preventive steps.
        </p>
      </div>
      
      <div style="display: grid; gap: 1.5rem; margin-top: 2rem;">
        {posts.map(post => (
          <article class="card">
            <time datetime={post.data.pubDate.toISOString()} class="text-muted" style="font-size: 0.9rem;">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h2 style="font-size: 1.35rem; margin: 0.35rem 0 0.5rem;">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h2>
            <p style="margin-bottom: 0.75rem;">{post.data.description}</p>
            <a href={`/blog/${post.slug}`} class="font-semibold">Read article →</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig, serviceAreas, services } from '../../data/site';
---

<BaseLayout
  title="Plumbing Service Areas | Lakewood, OH & Nearby"
  description="Plumbing services available in Lakewood, Rocky River, Fairview Park, Westlake, Bay Village, and nearby west-side Cleveland communities."
  canonicalPath="/service-areas"
>
  <section class="section" style="padding-top: 2.5rem;">
    <div class="container">
      <div class="section-header" style="text-align: left; max-width: none;">
        <h1>Where We Work</h1>
        <p class="text-muted" style="font-size: 1.15rem; max-width: 40rem;">
          We are based in Lakewood and regularly serve the surrounding communities. If your city is listed below, we are happy to help with repairs, installations, and maintenance.
        </p>
      </div>
      
      <div class="grid-2" style="margin-top: 2rem;">
        {serviceAreas.map(a => (
          <article class="card">
            <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">
              <a href={`/service-areas/${a.slug}`}>{a.name}</a>
            </h2>
            <p>{a.description}</p>
            <a href={`/service-areas/${a.slug}`} class="font-semibold">Area details →</a>
          </article>
        ))}
      </div>
      
      <div style="margin-top: 3rem; padding: 1.5rem; background: var(--color-bg-alt); border-radius: var(--radius);">
        <h2 style="font-size: 1.2rem;">Don't see your neighborhood?</h2>
        <p class="text-muted mb-0">
          We sometimes travel a bit farther for the right job. <a href="/contact">Reach out</a> with your location and we will let you know if we can help.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="text-center">Popular Services Across These Areas</h2>
      <div class="grid-3" style="margin-top: 1.5rem;">
        {services.slice(0, 6).map(s => (
          <a href={`/services/${s.slug}`} class="card" style="text-decoration: none; color: inherit;">
            <h3 style="font-size: 1.05rem;">{s.shortTitle}</h3>
            <p style="margin: 0; font-size: 0.9rem;">{s.description.slice(0, 90)}…</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig, services } from '../../data/site';
---

<BaseLayout
  title="Plumbing Services in Lakewood, OH"
  description="Full list of plumbing services available in Lakewood, Ohio: emergency repairs, drain cleaning, water heaters, sewer lines, fixtures, and more. Local team ready to help."
  canonicalPath="/services"
>
  <section class="section" style="padding-top: 2.5rem;">
    <div class="container">
      <div class="section-header" style="text-align: left; max-width: none; margin-bottom: 2rem;">
        <h1>Plumbing Services</h1>
        <p class="text-muted" style="font-size: 1.15rem; max-width: 40rem;">
          From urgent repairs to planned upgrades, here is what we handle for Lakewood and nearby homes. Select a service to learn more about our process and what to expect.
        </p>
      </div>
      
      <div class="grid-2" style="gap: 1.25rem;">
        {services.map(s => (
          <article class="card">
            <h2 style="font-size: 1.2rem; margin-bottom: 0.4rem;">
              <a href={`/services/${s.slug}`}>{s.title}</a>
            </h2>
            <p style="margin-bottom: 0.75rem;">{s.description}</p>
            <a href={`/services/${s.slug}`} class="font-semibold">Details & FAQ →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <h2>Not Sure Which Service You Need?</h2>
    <p>Describe the problem and we will point you in the right direction.</p>
    <a href="/contact" class="btn btn-primary btn-lg">Contact Us</a>
  </section>
</BaseLayout>

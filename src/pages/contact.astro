---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title="Contact Us | Plumber Lakewood Ohio"
  description="Contact our Lakewood plumbing team. Call, email, or send a message through the form. We respond promptly to service requests in Lakewood and nearby areas."
  canonicalPath="/contact"
>
  <section class="section" style="padding-top: 2.5rem;">
    <div class="container">
      <div class="grid-2" style="align-items: start; gap: 3rem;">
        <div>
          <h1>Contact Us</h1>
          <p class="text-muted" style="font-size: 1.1rem;">
            Tell us about the issue and the best way to reach you. For urgent problems—burst pipes, major leaks, sewage backups—call us directly.
          </p>
          
          <div style="margin-top: 2rem;">
            <p><strong>Phone</strong><br />
              <a href={siteConfig.phoneHref} style="font-size: 1.25rem; font-weight: 600;">{siteConfig.phone}</a>
            </p>
            <p style="margin-top: 1.25rem;"><strong>Email</strong><br />
              <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
            </p>
            <p style="margin-top: 1.25rem;"><strong>Address</strong><br />
              {siteConfig.address.street}<br />
              {siteConfig.address.city}, {siteConfig.address.state} {siteConfig.address.zip}
            </p>
            <p style="margin-top: 1.25rem;">
              <a href={siteConfig.address.mapsUrl} target="_blank" rel="noopener noreferrer">View on map →</a>
            </p>
          </div>
        </div>
        
        <div>
          <div id="form-wrapper">
            <form
              id="contact-form"
              action="https://api.web3forms.com/submit"
              method="POST"
              class="card"
              style="padding: 1.75rem;"
            >
              <input type="hidden" name="access_key" value={siteConfig.web3formsAccessKey} />
              <input type="hidden" name="subject" value="New plumbing service request from website" />
              <input type="hidden" name="from_name" value="Plumber Lakewood Ohio Website" />
              <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" />
              
              <div class="form-group">
                <label for="name">Name <span aria-hidden="true">*</span></label>
                <input type="text" id="name" name="name" required autocomplete="name" />
              </div>
              
              <div class="form-group">
                <label for="phone">Phone <span aria-hidden="true">*</span></label>
                <input type="tel" id="phone" name="phone" required autocomplete="tel" />
              </div>
              
              <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" autocomplete="email" />
              </div>
              
              <div class="form-group">
                <label for="service">Service needed</label>
                <select id="service" name="service">
                  <option value="">Select if known</option>
                  <option value="Emergency">Emergency / Urgent</option>
                  <option value="Drain Cleaning">Drain Cleaning</option>
                  <option value="Water Heater">Water Heater</option>
                  <option value="Leak">Leak Detection / Repair</option>
                  <option value="Toilet / Faucet">Toilet or Faucet</option>
                  <option value="Sewer">Sewer Line</option>
                  <option value="Other">Other / Not sure</option>
                </select>
              </div>
              
              <div class="form-group">
                <label for="message">How can we help? <span aria-hidden="true">*</span></label>
                <textarea id="message" name="message" required placeholder="Briefly describe the issue, location in the home, and any urgency."></textarea>
              </div>
              
              <button type="submit" class="btn btn-primary" style="width: 100%;" id="submit-btn">
                Send Message
              </button>
              <p class="text-muted" style="font-size: 0.85rem; margin-top: 0.75rem; margin-bottom: 0;">
                We use this information only to respond to your request.
              </p>
            </form>
          </div>
          
          <div id="thank-you" hidden class="card" style="padding: 2rem; text-align: center;">
            <h2 style="color: var(--color-success); margin-top: 0;">Thank you</h2>
            <p>Your message has been sent. We will get back to you as soon as we can. For urgent issues, please call <a href={siteConfig.phoneHref}>{siteConfig.phone}</a>.</p>
            <button type="button" class="btn btn-secondary" id="send-another" style="margin-top: 1rem;">Send another message</button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const wrapper = document.getElementById('form-wrapper');
  const thankYou = document.getElementById('thank-you');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const sendAnother = document.getElementById('send-another');

  if (form && wrapper && thankYou) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }
      
      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData
        });
        const result = await response.json();
        
        if (result.success) {
          wrapper.hidden = true;
          thankYou.hidden = false;
          form.reset();
        } else {
          alert(result.message || 'Something went wrong. Please try again or call us directly.');
        }
      } catch {
        alert('Unable to send right now. Please call us or try again later.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Message';
        }
      }
    });
  }
  
  if (sendAnother && wrapper && thankYou) {
    sendAnother.addEventListener('click', () => {
      thankYou.hidden = true;
      wrapper.hidden = false;
    });
  }
</script>

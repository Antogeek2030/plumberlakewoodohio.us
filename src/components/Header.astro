---
import { siteConfig, services } from '../data/site';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={`${siteConfig.name} home`}>
      Plumber<span>Lakewood</span>Ohio
    </a>
    
    <nav class="nav" aria-label="Main">
      <a href="/">Home</a>
      <div class="nav-dropdown">
        <button type="button" aria-expanded="false" aria-haspopup="true">
          Services
          <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
        </button>
        <div class="dropdown-menu" role="menu">
          <a href="/services" role="menuitem">All Services</a>
          {services.map(s => (
            <a href={`/services/${s.slug}`} role="menuitem">{s.shortTitle}</a>
          ))}
        </div>
      </div>
      <a href="/service-areas">Service Areas</a>
      <a href="/about">About</a>
      <a href="/blog">Blog</a>
      <a href="/contact">Contact</a>
    </nav>
    
    <a href={siteConfig.phoneHref} class="btn btn-primary header-cta" aria-label={`Call ${siteConfig.phone}`}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
      {siteConfig.phone}
    </a>
    
    <button class="mobile-toggle" type="button" aria-label="Open menu" aria-expanded="false" id="mobile-toggle">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
  
  <div class="mobile-nav" id="mobile-nav" hidden>
    <a href="/">Home</a>
    <a href="/services">Services</a>
    <div class="mobile-services">
      {services.slice(0, 8).map(s => (
        <a href={`/services/${s.slug}`}>{s.shortTitle}</a>
      ))}
      <a href="/services">View all services →</a>
    </div>
    <a href="/service-areas">Service Areas</a>
    <a href="/about">About</a>
    <a href="/blog">Blog</a>
    <a href="/contact">Contact</a>
    <a href={siteConfig.phoneHref} class="btn btn-primary" style="margin-top: 0.75rem; width: 100%;">Call {siteConfig.phone}</a>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const nav = document.getElementById('mobile-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      nav.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  }
</script>
